{
  "name": "portfolio-monorepo",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build:home": "pnpm --filter home build",
    "build:strava": "pnpm --filter stravavisuel build",
    "dev:home": "pnpm --filter home dev",
    "dev:strava": "pnpm --filter stravavisuel start",
    "verif:csp": "node scripts/verifier-coherence-csp.mjs",
    "verif": "pnpm verif:csp && pnpm -r typecheck && pnpm -r test"
  }
}
