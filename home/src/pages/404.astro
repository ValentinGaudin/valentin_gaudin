---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { contenuPageIntrouvable } from '~/content/not-found';

const content = contenuPageIntrouvable;
---

<BaseLayout meta={content.meta}>
  <main>
    <span class="code">{content.code}</span>
    <h1>{content.title}</h1>
    <p>{content.message}</p>
    <a href="/">{content.homeLabel}</a>
  </main>
</BaseLayout>

<style>
  main {
    min-height: 100vh;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    padding: var(--gutter);
  }

  .code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(64px, 14vw, 180px);
    line-height: 1;
    color: var(--accent);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 5vw, 58px);
    line-height: 1;
    margin: 0;
  }

  p {
    max-width: 460px;
    margin: 0;
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-a72);
  }

  a {
    align-self: flex-start;
    font-size: 13px;
    letter-spacing: .08em;
    padding: 15px 26px;
    background: var(--ink);
    color: var(--paper);
    transition: background .2s;
  }

  a:hover {
    background: var(--accent);
    color: var(--paper);
  }
</style>
