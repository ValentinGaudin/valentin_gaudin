---
import SectionHeading from '~/components/molecules/SectionHeading.astro';
import StackGroupCard from '~/components/molecules/StackGroupCard.astro';
import type { StackContent } from '~/content/types';

interface Props {
  content: StackContent;
}

const { content } = Astro.props;
---

<section id={content.sectionId} class="stack">
  <div class="columns">
    <div>
      <SectionHeading
        number={content.sectionNumber}
        title={content.title}
        spacing="compact"
      />
      <p class="intro">{content.intro}</p>

      <div class="groups">
        {content.groups.map((group) => <StackGroupCard group={group} />)}
      </div>
    </div>

    <div class="canvas-frame">
      <canvas data-torus-canvas aria-hidden="true"></canvas>
      <span class="caption">{content.canvasCaption}</span>
    </div>
  </div>
</section>

<style>
  .stack {
    border-top: 1px solid var(--ink-a14);
    padding: clamp(64px, 8vw, 96px) var(--gutter) clamp(72px, 8vw, 104px);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(36px, 4vw, 64px);
    align-items: start;
  }

  .intro {
    max-width: 460px;
    margin: 0 0 48px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink-a6);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0 clamp(26px, 3vw, 56px);
  }

  .canvas-frame {
    position: relative;
    height: clamp(300px, 38vw, 460px);
    border: 1px solid var(--ink-a14);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .caption {
    position: absolute;
    left: 20px;
    bottom: 18px;
    font-size: 11px;
    letter-spacing: .12em;
    color: var(--ink-a4);
  }
</style>
